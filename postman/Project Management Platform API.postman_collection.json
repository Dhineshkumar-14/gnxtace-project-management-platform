      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (response.data?.accessToken) {\r",
                  "    pm.environment.set(\r",
                  "        \"accessToken\",\r",
                  "        response.data.accessToken\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "if (response.data?.refreshToken) {\r",
                  "    pm.environment.set(\r",
                  "        \"refreshToken\",\r",
                  "        response.data.refreshToken\r",
                  "    );\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Login successful\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"admin@example.com\",\r\n    \"password\": \"Admin@123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
